{
  "name": "Reachr — All Reply Task Monitor",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "*/2 * * * *" }
          ]
        }
      },
      "id": "reachr-reply-monitor-schedule",
      "name": "Check replies every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [280, 300]
    },
    {
      "parameters": {
        "command": "cd /Users/jackserver/wildrose-automations/reachr-outreach && node monitor-good-replies.mjs",
        "executeTimeout": 120
      },
      "id": "reachr-reply-monitor-command",
      "name": "Create tasks for positive replies",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Check replies every 2 minutes": {
      "main": [[{ "node": "Create tasks for positive replies", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Edmonton",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "pinData": {}
}
